{
  "name": "haeditor",
  "version": "1.0.0-beta.1",
  "description": "GIMP + Inkscape Hybrid Graphical Editor for .hacanvas Documents & Shared Object Libraries",
  "main": "index.html",
  "node-remote": [
    "http://*",
    "https://*"
  ],
  "window": {
    "title": "HAEditor — Hybrid Raster & Vector Studio (.hacanvas)",
    "width": 1440,
    "height": 900,
    "min_width": 1000,
    "min_height": 680,
    "position": "center",
    "resizable": true,
    "show": true,
    "focus": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && nw .",
    "test": "npm run build && nw testrunner"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusTools/HAEditor.git"
  },
  "license": "MIT",
  "dependencies": {
    "@nexustools/aitooling": "^1.0.0-beta.2",
    "@nexustools/hacanvas": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nw": "^0.115.0",
    "typescript": "^5.7.0"
  }
}
